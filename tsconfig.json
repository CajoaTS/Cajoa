{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "cajoa",
    "noEmit": true,
    "paths": {
      "cajoa": ["./packages/cajoa/src/index.ts"],
      "@cajoa/core": ["./packages/core/src/index.ts"],
      "@cajoa/dom": ["./packages/dom/src/index.ts"],
      "cajoa/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "cajoa/jsx-dev-runtime": ["./packages/core/src/jsx-runtime.ts"]
    }
  },
  "include": ["packages/*/src", "tests", "playground"]
}
