{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "cajoa",
    "noEmit": true,
    "paths": {
      "cajoa": ["./packages/cajoa/src/index.ts"],
      "@cajoa/core": ["./packages/core/src/index.ts"],
      "@cajoa/dom": ["./packages/dom/src/index.ts"],
      "@cajoa/server": ["./packages/server/src/index.ts"],
      "cajoa/server": ["./packages/cajoa/src/server.ts"],
      "cajoa/jsx-runtime": ["./packages/cajoa/src/index.ts"],
      "cajoa/jsx-dev-runtime": ["./packages/cajoa/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "tests",
    "playground",
    "create-cajoa/template/src",
    "e2e",
    "bench"
  ]
}
