{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "cajoa",
    "paths": {
      "cajoa": ["./src/index.ts"],
      "cajoa/jsx-runtime": ["./src/jsx-runtime.ts"],
      "cajoa/jsx-dev-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "include": ["src", "tests", "playground"]
}
