{
  "name": "cajoa-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "create-cajoa"
  ],
  "scripts": {
    "dev": "vite --open /playground/",
    "build": "npm run build -w @cajoa/core && npm run build -w @cajoa/dom && npm run build -w @cajoa/server && npm run build -w cajoa",
    "test": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w @cajoa/core",
    "sync": "node scripts/sync-readme.mjs",
    "sync:create": "node scripts/sync-create-cajoa.mjs",
    "check:sync": "node scripts/sync-readme.mjs --check && node scripts/sync-create-cajoa.mjs --check",
    "check:packages": "npm run check:package -w @cajoa/core -w @cajoa/dom -w cajoa",
    "check:exports": "node scripts/check-exports.mjs",
    "verify": "npm run typecheck && vitest run && npm run build && npm run check:sync && npm run check:packages && npm run check:exports  && npm run check:size && npm run check:ssr",
    "check:ssr": "node scripts/check-ssr.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm run sync && npm run sync:create && npm install --package-lock-only",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install",
    "bench": "node bench/run-reactivity.mjs",
    "bench:browser": "node bench/run-browser.mjs",
    "check:size": "node scripts/check-size.mjs",
    "size:update": "node scripts/check-size.mjs --write",
    "release": "npm run verify && changeset publish "
  },
  "author": "cjmgrc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/CajoaTS/Cajoa/issues"
  },
  "homepage": "https://github.com/CajoaTS/Cajoa#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
