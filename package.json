{
  "name": "cajoa-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --open /playground/",
    "build": "npm run build -w @cajoa/core && npm run build -w @cajoa/dom && npm run build -w cajoa",
    "test": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w @cajoa/core"
  },
  "author": "cjmgrc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/CajoaTS/Cajoa/issues"
  },
  "homepage": "https://github.com/CajoaTS/Cajoa#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
