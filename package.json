{
  "name": "cajoa",
  "version": "0.2.0",
  "description": "A beginner-friendly, signals-based frontend framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --open /playground/",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest",
    "prepublishOnly": "vitest run && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CajoaTS/Cajoa.git"
  },
  "keywords": [
    "frontend",
    "framework",
    "signals",
    "reactive",
    "ui",
    "cajoa"
  ],
  "author": "cjmgrc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/CajoaTS/Cajoa/issues"
  },
  "homepage": "https://github.com/CajoaTS/Cajoa#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
