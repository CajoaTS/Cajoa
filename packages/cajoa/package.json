{
  "name": "cajoa",
  "version": "0.8.0",
  "description": "A small, beginner-friendly frontend framework built on signals and JSX.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "jsx-runtime": [
        "./dist/index.d.ts"
      ],
      "jsx-dev-runtime": [
        "./dist/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "dependencies": {
    "@cajoa/core": "^0.8.0",
    "@cajoa/dom": "^0.8.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check:package": "publint && attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CajoaTS/Cajoa.git",
    "directory": "packages/cajoa"
  },
  "keywords": [
    "frontend",
    "framework",
    "signals",
    "reactive",
    "ui",
    "cajoa"
  ],
  "author": "cjmgrc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/CajoaTS/Cajoa/issues"
  },
  "homepage": "https://github.com/CajoaTS/Cajoa#readme"
}
